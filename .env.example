# Optional. Copy to .env (git-ignored) and fill in ONE key. Keep this file free of real keys.

# Anthropic Claude (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: force a provider when both keys are set (anthropic | gemini)
# AI_PROVIDER=gemini